# =====================================================================
# .env — Bot Toko (project terpisah dari RK Destu Store)
#
# CATATAN: saya belum lihat kode project ini, jadi saya cuma susun
# ulang 5 nilai yang kamu kasih supaya rapi dan siap paste. Pastikan
# NAMA variabel di bawah ini SAMA PERSIS dengan yang dibaca kode bot-mu
# (misal getenv('BOT_TOKEN') di Node.js/PHP-nya) — kalau beda nama,
# variabelnya tidak akan terbaca walau nilainya benar.
#
# CARA PAKAI DI RAILWAY:
# Tab "Variables" pada service bot ini -> klik "Raw Editor" -> paste
# seluruh isi file ini -> Save.
# =====================================================================

# ID Telegram admin yang berhak mengelola bot (bisa lebih dari satu,
# biasanya dipisah koma kalau kodenya mendukung banyak admin, mis:
# ADMIN_IDS=8084747964,111222333)
ADMIN_IDS=8084747964

# Token bot dari @BotFather
BOT_TOKEN=8904998017:AAFdPWdy9QBFuQsEHLIQVJbmjbgPA3Jkto8

# ID grup/channel Telegram tempat live chat pelanggan masuk
LIVECHAT_GROUP_ID=-1002559959100

# ID chat/channel tempat log aktivitas bot dikirim
LOG_CHAT_ID=-1002559959100

# URL web app (Railway) tempat bot/website ini di-deploy
WEBAPP_URL=https://website-official-gelisah.up.railway.app
